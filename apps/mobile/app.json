{
    "expo": {
        "name": "One Chitra RFID",
        "slug": "one-chitra-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "scheme": "one-chitra",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#0f172a"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.onechitra.rfid"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#0f172a"
            },
            "package": "com.onechitra.rfid",
            "permissions": [
                "android.permission.CAMERA",
                "android.permission.VIBRATE"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            [
                "expo-camera",
                {
                    "cameraPermission": "Allow One Chitra RFID to access your camera for barcode scanning."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}