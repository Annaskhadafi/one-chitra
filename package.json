{
  "name": "codeguide-starter-fullstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest --run",
    "test:mobile": "vitest --run lib/__tests__/mobile-tables-audit.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:approval": "npx tsx scripts/test-approval-e2e.ts && npx tsx scripts/test-approval-reject-email.ts",
    "test:approval:graph": "npx tsx scripts/test-approval-graph-routing.ts",
    "audit:actions": "node scripts/audit-server-actions.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down postgres",
    "db:dev": "docker compose --profile dev up postgres-dev -d",
    "db:dev-down": "docker compose --profile dev down postgres-dev",
    "db:seed": "npx tsx db/seed.ts",
    "db:clear": "npx tsx db/clear.ts",
    "db:migrate:ai-forecast": "npx tsx db/migrate-ai-forecast.ts",
    "kill:dev": "node kill-ports.js",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "docker:build": "docker build -t codeguide-starter-fullstack .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "navbar:sync-approvals": "npx tsx scripts/sync-navbar-approvals.ts",
    "storage:migrate": "npx tsx scripts/migrate-uploads-to-object-storage.ts",
    "prepare": "husky",
    "check-types": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "app/**/*.{ts,tsx}": [
      "npm run audit:actions"
    ]
  },
