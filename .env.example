# ============================================
# One Chitra - Environment Variables
# Copy this file to .env and modify as needed
# ============================================

# Database Configuration (NeonDB)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (better-auth)
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# File Upload Configuration
# For production/Dokploy: Set UPLOAD_DIR to match your mounted volume path
# Example: UPLOAD_DIR=/app/.next/standalone/public/uploads
# Mount: /mnt/data/one-chitra/uploads -> /app/.next/standalone/public/uploads
# For development: Leave empty to use public/uploads
# UPLOAD_DIR=/app/.next/standalone/public/uploads

# ============================================
# Production / Dokploy (set in Dokploy UI)
# ============================================
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# UPLOAD_DIR=/app/.next/standalone/public/uploads
# PORT=3000
# HOSTNAME=0.0.0.0