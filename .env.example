# ============================================
# One Chitra - Environment Variables
# Copy this file to .env and modify as needed
# ============================================

# Database Configuration (NeonDB)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (better-auth)
# Use a high-entropy secret (>= 32 chars). Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_64_hex_chars_generated_secret
# Optional: enforce secret strength as a hard error (can affect app startup/login if misconfigured)
# BETTER_AUTH_ENFORCE_STRICT_SECRET=false
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# File Upload Configuration
# For production/Dokploy: Set UPLOAD_DIR to match your mounted volume path
# Example: UPLOAD_DIR=/app/.next/standalone/public/uploads
# Mount: /mnt/data/one-chitra/uploads -> /app/.next/standalone/public/uploads
# For development: Leave empty to use public/uploads
# UPLOAD_DIR=/app/.next/standalone/public/uploads

# ============================================
# Production / Dokploy (set in Dokploy UI)
# ============================================
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# UPLOAD_DIR=/app/.next/standalone/public/uploads
# PORT=3000
# HOSTNAME=0.0.0.0


# Cron Job Security
# Secret token for securing cron job endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret_here
