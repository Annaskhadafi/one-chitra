# ============================================
# One Chitra - Environment Variables
# Copy this file to .env and modify as needed
# ============================================

# Database Configuration (NeonDB)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (better-auth)
# Use a high-entropy secret (>= 32 chars). Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_64_hex_chars_generated_secret
# Optional: enforce secret strength as a hard error (can affect app startup/login if misconfigured)
# BETTER_AUTH_ENFORCE_STRICT_SECRET=false
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
WIP_REPAIR_API_URL=https://ics.chitraparatama.co.id/product/get_api.php?function=wo_repair

# Web Push / PWA Notification
# Generate with:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:admin@example.com

# File Upload Configuration
# Recommended for deployment: use S3-compatible object storage
UPLOAD_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://is3.cloudhost.id
OBJECT_STORAGE_BUCKET=your-bucket-name
OBJECT_STORAGE_PREFIX=upload
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
#
# Legacy/local filesystem fallback:
# For production/Dokploy without object storage, set UPLOAD_DRIVER=local
# and point UPLOAD_DIR to your mounted volume path.
# Example: UPLOAD_DIR=/app/uploads
# Mount: /mnt/data/one-chitra/uploads -> /app/uploads
# For development: Leave empty to use public/uploads
# UPLOAD_DIR=/app/uploads
# Optional for local development when using a shared remote database:
# if some uploaded files live on the production server, set this to the
# production app base URL so /api/uploads can proxy missing files there.
# UPLOAD_FALLBACK_BASE_URL=https://yourdomain.com

# ============================================
# Production / Dokploy (set in Dokploy UI)
# ============================================
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# UPLOAD_DRIVER=s3
# OBJECT_STORAGE_ENDPOINT=https://is3.cloudhost.id
# OBJECT_STORAGE_BUCKET=your-bucket-name
# OBJECT_STORAGE_PREFIX=upload
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
# OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# PORT=3000
# HOSTNAME=0.0.0.0


# Cron Job Security
# Secret token for securing cron job endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret_here

# Ollama Configuration (Magic Email Generator)
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_MODEL=qwen3.5:397b-cloud
OLLAMA_API_KEY=0f6943349a014608a78bbed67356697a.Gjpmub8qLOAkXW_DSM4OMfkH

# API key required for WIP Repair public API endpoints
WIP_REPAIR_API_KEY=
